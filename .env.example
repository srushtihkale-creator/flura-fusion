# Flora Fusion — Environment Configuration
# Optional: Set this to your Spring Boot REST API base URL
# Example: http://localhost:8080/api/v1
# If left empty, Flora Fusion automatically runs in standalone mode with complete local mock services.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# WhatsApp Click-to-Chat Number (format: Country code + number without + or spaces, e.g., 91XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

