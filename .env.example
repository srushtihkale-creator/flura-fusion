# Flora Fusion — Environment Configuration
# Optional: Set this to your Spring Boot REST API base URL
# Example: http://localhost:8080/api/v1
# If left empty, Flora Fusion automatically runs in standalone mode with complete local mock services.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# WhatsApp Click-to-Chat Number (format: Country code + number without + or spaces, e.g., 91XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Razorpay Payment Gateway (Test or Live Key ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_TkGZqDthTkR6pj
# Google Identity Services / OAuth 2.0 Client ID (Frontend "Continue with Google")
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Email Configuration (Optional for Vercel Serverless Route / Standalone Mode):
# BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here
# BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
# BREVO_SENDER_NAME=Flora Fusion
# RESEND_API_KEY=re_your_resend_api_key_here

