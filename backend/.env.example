# Flora Fusion Backend Environment Configuration (Example)
# Copy this file to .env and fill in your local PostgreSQL credentials

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Local PostgreSQL Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/flora_fusion
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_local_password_here

# JWT Secret (Base64 or 256-bit hex key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Business Rules
COMMERCE_FREE_SHIPPING_THRESHOLD=799.00
COMMERCE_STANDARD_SHIPPING_FEE=79.00

# Google Gemini API (Used ONLY by Spring Boot backend, never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Frontend URL (For email links & password reset redirects)
FRONTEND_URL=http://localhost:3000

# Email System (Provider-Agnostic: smtp | resend | mock)
EMAIL_PROVIDER=smtp
EMAIL_FROM=Flora Fusion <srushti.h.kale2004@gmail.com>

# SMTP / Gmail SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Resend API Credentials (Preserved Alternative / Fallback Provider)
RESEND_API_KEY=re_your_resend_api_key_here

# Razorpay Payment Gateway (Test or Production)
RAZORPAY_KEY_ID=rzp_test_TkGZqDthTkR6pj
RAZORPAY_KEY_SECRET=your_razorpay_secret_here


