# Flora Fusion Backend Environment Configuration (Example)
# Copy this file to .env and fill in your local PostgreSQL credentials

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Local PostgreSQL Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/flora_fusion
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_local_password_here

# JWT Secret (Base64 or 256-bit hex key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Business Rules
COMMERCE_FREE_SHIPPING_THRESHOLD=799.00
COMMERCE_STANDARD_SHIPPING_FEE=79.00

# Google Gemini API (Used ONLY by Spring Boot backend, never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Frontend URL (For email links & password reset redirects)
FRONTEND_URL=http://localhost:3000

# Email System Configuration:
# - Local development (SPRING_PROFILES_ACTIVE=dev): automatically uses SMTP
# - Production deployment (SPRING_PROFILES_ACTIVE=prod): automatically uses Brevo
# - Optional manual override: EMAIL_PROVIDER=smtp | brevo | resend | mock
EMAIL_PROVIDER=
EMAIL_FROM=Flora Fusion <noreply@florafusion.com>

# 1. Local Development — SMTP / Gmail SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true

# 2. Production Deployment — Brevo (Sendinblue) Transactional REST API Credentials
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
BREVO_SENDER_NAME=Flora Fusion

# 3. Preserved Alternative / Fallback Provider — Resend API Credentials
RESEND_API_KEY=re_your_resend_api_key_here

# Razorpay Payment Gateway (Test or Production)
RAZORPAY_KEY_ID=rzp_test_TkGZqDthTkR6pj
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Shiprocket Official Logistics Configuration (Backend-Only)
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_TEST_MODE=true
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Google OAuth 2.0 / Google Identity Services (Backend Token Verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# n8n Cloud Promotional Email Automation
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/flora-campaign
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_token_here
N8N_INTERNAL_SECRET=your_backend_internal_secret_token_here

